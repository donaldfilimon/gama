#usda 1.0
(
    customLayerData = {
        int "gama:formatVersion" = 1
        uint64 "gama:nextEntityID" = 7
    }
    defaultPrim = "Key"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Key"
{
    custom uint64 gama:id = 1
    custom string gama:name = "Key"
    float3 xformOp:translate = (0, 0, 0)
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    def DistantLight "GamaLight"
    {
        custom bool gama:component = 1
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 3
        custom float gama:intensity = 3000
    }
    def Xform "Table" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        custom uint64 gama:id = 2
        custom string gama:name = "Table"
        float3 xformOp:translate = (0, 1, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        rel material:binding = </Key/Looks/M_2>
        def Cube "GamaMesh"
        {
            custom bool gama:component = 1
            double size = 1
        }
        def Cylinder "Cup" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom uint64 gama:id = 3
            custom string gama:name = "Cup"
            uniform token axis = "Y"
            double height = 1
            double radius = 0.5
            rel material:binding = </Key/Looks/M_3>
        }
    }
    def Xform "Group"
    {
        custom uint64 gama:id = 4
        custom string gama:name = "Group"
        def SphereLight "Fill"
        {
            custom uint64 gama:id = 5
            custom string gama:name = "Fill"
            color3f inputs:color = (1, 1, 1)
            float inputs:intensity = 26.96376
            custom float gama:intensity = 26963.76
            bool treatAsPoint = 1
            custom float gama:attenuationRadius = 10
        }
    }
    def Scope "Looks"
    {
        def Material "M_2"
        {
            token outputs:surface.connect = </Key/Looks/M_2/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "M_3"
        {
            token outputs:surface.connect = </Key/Looks/M_3/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.2, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
}

def Camera "Lens"
{
    custom uint64 gama:id = 6
    custom string gama:name = "Lens"
    float2 clippingRange = (0.01, 1000)
    float focalLength = 20.784609
    float verticalAperture = 24
    custom float gama:fieldOfView = 60
}
